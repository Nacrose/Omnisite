# OmniSite — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase (required for cloud database + real-time + auth) ──────────────
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side key (for audit logging — bypasses RLS, NEVER expose to client)
# Get from Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Auth redirect URLs (configure in Supabase Dashboard) ──────────────────
# The "Forgot your password?" flow on /login calls Supabase's
# resetPasswordForEmail() which sends a recovery link. The link's redirect
# URL must be in Supabase's allowlist:
#   Dashboard → Authentication → URL Configuration → Redirect URLs
#
# Add both of these for local + production:
#   http://localhost:3000/login
#   https://your-production-domain.com/login
# (The redirect URL is sent at runtime by the client — see auth.tsx.)

# ─── Rate Limiting (Upstash Redis — required in production) ─────────────────
# Get these from https://console.upstash.com
# Without these, API routes will throw on every request.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Set to true only when behind a reverse proxy (Vercel, Cloudflare, etc.)
# Controls whether x-forwarded-for header is trusted for rate-limit keying.
# NOTE: auto-set to true on Vercel deployments (process.env.VERCEL === '1').
# TRUST_PROXY=true

# ─── Error Monitoring (Sentry — optional) ──────────────────────────────────
# Get this from https://sentry.io
# Without this, errors are only logged to console.
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/123

# ─── Email Notifications (Resend — optional) ───────────────────────────────
# When set, overdue RFI / NCR / PO alerts are sent via email.
# RESEND_API_KEY=re_your-key
# EMAIL_FROM=noreply@yourdomain.com

# ─── SMS Notifications (Twilio — optional) ─────────────────────────────────
# When set, critical alerts are sent via SMS.
# TWILIO_ACCOUNT_SID=ACyour-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_PHONE_NUMBER=+1234567890
