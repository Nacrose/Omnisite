# OmniSite — Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase (required for cloud database + real-time + auth)
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Database (for Prisma — only needed if using Prisma instead of Supabase)
# DATABASE_URL=postgresql://user:password@host:port/database

# The app works without these (falls back to localStorage) but data won't sync across devices
